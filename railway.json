{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx prisma generate --schema=apps/api/prisma/schema.prisma && npm run build -w @sync/api"
  },
  "deploy": {
    "startCommand": "npm run start:migrate -w @sync/api",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
