generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  fullName           String
  email              String    @unique
  username           String?   @unique
  avatarUrl          String?
  roleId             String
  divisionId         String?
  status             String    @default("PENDING")
  authProvider       String    @default("LOCAL")
  passwordHash       String?
  googleSubject      String?   @unique
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  timezone           String    @default("Asia/Jakarta")
  theme              String    @default("light")
  density            String    @default("comfortable")
  language           String    @default("id")
  notifyApprovals    Boolean   @default(true)
  notifyConflicts    Boolean   @default(true)
  notifyReviews      Boolean   @default(true)
  notifyTasks        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  role              Role               @relation(fields: [roleId], references: [id])
  division          Division?          @relation(fields: [divisionId], references: [id])
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  uploadedDocuments Document[]         @relation("DocumentUploader")
  submissions       DocumentSubmission[]
  reviews           Review[]
  requestedApprovals Approval[]        @relation("ApprovalRequester")
  ownedConflicts    Conflict[]         @relation("ConflictOwner")
  auditLogs         AuditLog[]
  notifications     Notification[]
  approvalSteps     ApprovalStep[]
  resolutions       ConflictResolution[]
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Division {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  programs  Program[] @relation("ProgramOwnerDivision")
  tasks     Task[]
  documents Document[]
}

model Program {
  id              String    @id @default(cuid())
  name            String
  description     String?
  ownerDivisionId String?
  status          String    @default("PLANNING")
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownerDivision Division? @relation("ProgramOwnerDivision", fields: [ownerDivisionId], references: [id])
  tasks         Task[]
  documents     Document[]
}

model Task {
  id          String    @id @default(cuid())
  programId   String?
  title       String
  description String?
  status      String    @default("BACKLOG")
  priority    String    @default("MEDIUM")
  assigneeId  String?
  creatorId   String?
  divisionId  String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  program  Program?  @relation(fields: [programId], references: [id])
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User?     @relation("TaskCreator", fields: [creatorId], references: [id])
  division Division? @relation(fields: [divisionId], references: [id])
}

model Document {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String
  fileSize     Int
  storageKey   String
  status       String   @default("DRAFT")
  title        String?
  description  String?
  uploadedById String
  divisionId   String?
  programId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy  User                 @relation("DocumentUploader", fields: [uploadedById], references: [id])
  division    Division?            @relation(fields: [divisionId], references: [id])
  program     Program?             @relation(fields: [programId], references: [id])
  versions    DocumentVersion[]
  submissions DocumentSubmission[]
  reviews     Review[]
  proposals   ProposedItem[]
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      Int
  storageKey   String
  fileName     String
  uploadedById String?
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentSubmission {
  id           String    @id @default(cuid())
  documentId   String
  submittedById String
  status       String    @default("SUBMITTED")
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  returnReason String?

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  submittedBy User     @relation(fields: [submittedById], references: [id])
}

model Review {
  id          String    @id @default(cuid())
  documentId  String
  reviewerId  String?
  status      String    @default("PENDING")
  comment     String?
  riskLevel   String    @default("MEDIUM")
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewer User?    @relation(fields: [reviewerId], references: [id])
}

model ProposedItem {
  id         String   @id @default(cuid())
  documentId String
  fieldKey   String
  fieldLabel String
  value      String
  evidence   String?
  confirmed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Approval {
  id           String   @id @default(cuid())
  subjectType  String
  subjectId    String?
  title        String
  summary      String?
  requesterId  String
  currentStep  Int      @default(0)
  status       String   @default("PENDING")
  riskLevel    String   @default("MEDIUM")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requester User           @relation("ApprovalRequester", fields: [requesterId], references: [id])
  steps     ApprovalStep[]
}

model ApprovalStep {
  id          String    @id @default(cuid())
  approvalId  String
  stepOrder   Int
  approverId  String?
  roleLabel   String
  status      String    @default("PENDING")
  comment     String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  approver User?    @relation(fields: [approverId], references: [id])
}

model Conflict {
  id          String   @id @default(cuid())
  type        String
  severity    String   @default("MEDIUM")
  status      String   @default("DETECTED")
  title       String
  description String?
  sourceRefs  String
  ownerId     String?
  recommendation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User?                 @relation("ConflictOwner", fields: [ownerId], references: [id])
  resolutions ConflictResolution[]
}

model ConflictResolution {
  id          String   @id @default(cuid())
  conflictId  String
  resolvedById String
  decision    String
  notes       String?
  createdAt   DateTime @default(now())

  conflict   Conflict @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  resolvedBy User     @relation(fields: [resolvedById], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  oldValue   String?
  newValue   String?
  metadata   String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  readAt    DateTime?
  link      String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id                   String  @id @default("default")
  googleOidcEnabled    Boolean @default(false)
  localAuthEnabled     Boolean @default(true)
  allowedEmailDomain   String  @default("cakrawala.ac.id")
  maxUploadBytes       Int     @default(10485760)
  sessionTimeoutMinutes Int    @default(480)
  requireFirstLoginChange Boolean @default(true)
}
